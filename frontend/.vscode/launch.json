{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Start server (ng serve)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "serve", "--host", "0.0.0.0"],
      "console": "integratedTerminal"
    },
    {
      "name": "3. Attach to Chrome (ng serve)",
      "type": "chrome",
      "request": "attach",
      "address": "nginx",
      "port": 9222,
      "url": "http://localhost:4200/*",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
