{$DOMAIN} {
	handle_path /api/* {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# WordScene shares HTTPS without exposing another host port.
wordscene.duckdns.org {
    redir https://wordscene.dynv6.net{uri} 302
}

wordscene.dynv6.net {
    reverse_proxy wordscene-api:3000 {
        header_up X-Forwarded-For {remote_host}
        header_up -CF-Connecting-IP
        header_up -X-Real-IP
        header_up -Forwarded
    }
}
